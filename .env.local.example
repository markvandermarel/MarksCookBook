# Copy this file to .env.local for local backend settings.
# Keep .env.local out of git; it may contain secrets.

# When this is empty, npm start uses backend mock extraction for localhost testing.
# Set a real key to call the provider from api/extract-recipe.js.
OPENAI_API_KEY=

# Optional. The backend default is defined in api/extract-recipe.js.
OPENAI_MODEL=gpt-5.4-mini

# Optional but recommended when deployed. Multiple origins can be comma-separated.
ALLOWED_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Optional. true forces mock responses; false disables implicit localhost mock mode.
# MOCK_RECIPE_EXTRACTION=true
